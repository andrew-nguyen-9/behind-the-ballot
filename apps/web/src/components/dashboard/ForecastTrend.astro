---
import { cn } from "../../lib/utils";
import ChartReadout from "../charts/ChartReadout.astro";
import { sparkline, type TrendPoint } from "./forecastTrend";
import type { RaceForecast } from "../../lib/forecast";

// Forecast dashboard figure [E-5]: a 0-JS win-probability gauge for the LATEST forecast plus,
// once the snapshot store (forecast_snapshots, Neon) has archived ≥2 runs, a win-prob trend
// sparkline. The forecast is DERIVED — it has no upstream source row of its own; provenance is
// the methodology + per-snapshot input union [R14a], surfaced via the /forecast link the caller
// already renders. History baked to src/data/forecast-history/<raceId>.json by the cron writer;
// absent → honest-empty trend note, never a fabricated point. The E-3 <ChartReadout> island
// layers a hover/keyboard-focus value readout over the server-rendered marks (0-JS still shows
// the gauge label + every point's data-readout value).
interface Props {
  current: RaceForecast | null;
  history?: TrendPoint[];
  class?: string;
}
const { current, history = [], class: className } = Astro.props;
const spark = sparkline(history);
const demPct = current ? Math.round(current.win_prob * 100) : null;
---

{demPct !== null ? (
  <ChartReadout label="Forecast readout" class={cn("mt-2 max-w-md", className)}>
    <figure class="m-0">
      <figcaption class="mb-1 flex items-baseline justify-between text-sm">
        <span class="text-muted">Democratic win probability</span>
        <span class="font-bold tabular-nums">{demPct}%</span>
      </figcaption>
      {/* 0–100 win-probability gauge; the fill is a single readout mark. */}
      <div class="relative h-3 overflow-hidden rounded-full bg-[var(--color-border)]">
        <span
          data-readout
          data-readout-label="Democratic win probability"
          data-readout-value={`${demPct}%`}
          tabindex="0"
          role="img"
          aria-label={`Democratic win probability ${demPct} percent`}
          class="absolute inset-y-0 left-0 block rounded-full bg-[var(--color-accent)] outline-offset-2"
          style={`width:${demPct}%`}
        ></span>
      </div>

      {spark ? (
        <div class="mt-4">
          <p class="mb-1 text-xs text-muted">
            Win-probability trend · {spark.points.length} forecast runs
          </p>
          <svg
            viewBox={`0 0 ${spark.width} ${spark.height}`}
            class="h-14 w-full"
            role="img"
            aria-label={`Democratic win probability trend from ${spark.points[0].pct}% on ${spark.points[0].date} to ${demPct}% on ${spark.points[spark.points.length - 1].date}`}
            preserveAspectRatio="none"
          >
            <path d={spark.area} class="fill-[var(--color-accent)] opacity-10" />
            <polyline
              points={spark.line}
              class="fill-none stroke-[var(--color-accent)]"
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
            {spark.points.map((p) => (
              <circle
                cx={p.x}
                cy={p.y}
                r="3.5"
                data-readout
                data-readout-label={p.date}
                data-readout-value={`${p.pct}% Dem`}
                tabindex="0"
                class="fill-[var(--color-accent)] outline-offset-2"
              >
                <title>{p.date} — {p.pct}% Dem</title>
              </circle>
            ))}
          </svg>
        </div>
      ) : (
        <p class="mt-3 text-xs text-muted">
          Trend begins once the daily forecast runs are archived — a single reading is not a
          trend, so no line is drawn yet.
        </p>
      )}
    </figure>
  </ChartReadout>
) : (
  <p class={cn("mt-2 text-sm text-muted", className)}>No forecast published for this race yet.</p>
)}
