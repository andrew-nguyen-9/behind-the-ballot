---
import { cn } from "../lib/utils";
import { partyColorClass, partyLabel, partyPatternClass } from "../lib/races";
import { computeSegments, type BarSegment } from "./partyBar";

// Horizontal party bar. One call = one bar. Stacked (byParty, no `max`) or single-fill
// (one segment scaled to `max`, e.g. finance/polling). Bar widths stay inline
// `style={width:%}` per spec. Default height h-4 — pass `class="h-2"` for thin bars.
// `pattern` (E0.4) overlays a per-party hatch/dots/crosshatch for grayscale legibility. [C5a]
interface Props {
  segments: BarSegment[];
  max?: number;
  pattern?: boolean;
  class?: string;
}
const { segments, max, pattern = false, class: className } = Astro.props;
const computed = computeSegments(segments, max);
const ariaLabel = computed.map((s) => s.label ?? `${partyLabel(s.party)}: ${s.value}`).join(", ");
---
<div
  class={cn("flex h-4 w-full overflow-hidden rounded-sm bg-surface-2", className)}
  role="img"
  aria-label={ariaLabel}
>
  {computed.map((s) => (
    <span
      class={cn("block h-full", partyColorClass(s.party), pattern ? partyPatternClass(s.party) : undefined)}
      style={`width:${s.pct}%`}
      data-pattern={pattern ? "" : undefined}
    ></span>
  ))}
</div>
