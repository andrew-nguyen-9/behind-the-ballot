---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import DataTable from "../components/DataTable.astro";
import type { Column } from "../components/dataTable";
import {
  byCompactness,
  efficiencyGapLabel,
  stateFairness,
} from "../lib/gerrymander";

// Multi-metric, caveated, NO single verdict [L8a]. Metrics computed offline from TIGER
// [L6a]; full methodology below [L14a].
const states = stateFairness();
const leastCompact = byCompactness(true).slice(0, 3);
const fmtSeat = (n: number) => `${Math.round(n * 100)}%`;

const fairnessColumns: Column[] = [
  { key: "state", label: "State" },
  { key: "gap", label: "Efficiency gap" },
  { key: "mm", label: "Mean–median", align: "right" },
  { key: "sv", label: "Seats / votes (D)", align: "right" },
];
const fairnessRows = states.map((s) => ({
  state: s.state,
  gap: efficiencyGapLabel(s.efficiency_gap),
  mm: `${(s.mean_median * 100).toFixed(1)} pts`,
  sv: `${fmtSeat(s.dem_seat_share)} / ${fmtSeat(s.dem_vote_share)}`,
}));
---

<Layout
  title="Gerrymandering"
  description="District compactness and partisan-fairness metrics — multiple measures, with caveats."
>
  <h1 class="text-3xl font-bold">Gerrymandering</h1>
  <p class="mt-2 max-w-prose text-muted">
    We report <strong>several</strong> measures of compactness and partisan fairness. They
    often disagree, and no single number proves a map is gerrymandered — read them together
    and with the caveats below. Metrics are computed offline from Census TIGER district
    geometry. Source: <a href="/sources" class="underline">TIGER/Line</a>.
  </p>

  <section class="mt-8" aria-labelledby="fairness">
    <SectionHeader title="Partisan fairness by state" id="fairness" />
    {states.length === 0 ? (
      <p class="mt-3 max-w-prose text-muted">
        Partisan-fairness measures (efficiency gap, mean–median) need each district's election
        result on the <em>current</em> (post-2020) boundaries. This is now wired to our
        <a href="/sources" class="underline">election-results</a> feed and computes a state's
        metrics once <em>all</em> its U.S. House districts have reported certified results — until
        then we show nothing rather than a partial or placeholder number. Compactness below is
        already computed from real district geometry.
      </p>
    ) : (
      <>
        <DataTable
          class="mt-3"
          columns={fairnessColumns}
          rows={fairnessRows}
          caption="Partisan-fairness metrics by state"
        />
        <p class="mt-2 text-xs text-muted">
          Efficiency gap &amp; mean–median have known limitations (sensitive to uncontested
          seats, statewide lean); treat as signals, not verdicts.
        </p>
      </>
    )}
  </section>

  <section class="mt-8" aria-labelledby="compact">
    <SectionHeader title="Least compact districts" id="compact" />
    <ul class="mt-3 space-y-2" role="list">
      {leastCompact.map((d) => (
        <li class="flex justify-between text-sm">
          <span class="font-medium">{d.state}-{String(d.district).padStart(2, "0")}</span>
          <span class="tabular-nums text-muted">
            Polsby-Popper {d.polsby_popper.toFixed(2)} · Reock {d.reock.toFixed(2)} ·
            convex-hull {d.convex_hull_ratio.toFixed(2)}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8" aria-labelledby="method">
    <SectionHeader title="Methodology" id="method" />
    <p class="mt-2 max-w-prose text-sm text-muted">
      Compactness: Polsby-Popper (4π·area/perimeter²), Reock (area / min-bounding-circle),
      and convex-hull ratio — each 1.0 at most compact. Computed on an equal-area projection
      (US Albers, EPSG:5070), which is tuned for the contiguous states, so Alaska, Hawaii, and
      territories are approximate. Fairness: efficiency gap (wasted
      votes) and mean–median (mean minus median district vote share). Boundaries are
      versioned by <code>as_of</code> to track court-ordered changes. Ensemble/simulation
      analysis is planned for a later release.
    </p>
  </section>
</Layout>
