---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatBlock from "../components/StatBlock.astro";
import DataTable from "../components/DataTable.astro";
import EmptyState from "../components/EmptyState.astro";
import type { Column } from "../components/dataTable";
import {
  stateSnapshotTable,
  districtSnapshotTable,
  nationalTotals,
  stateChanges,
  districtChanges,
  changeMetadata,
  hasChangeData,
  fmtPop,
  fmtIncome,
  fmtDelta,
  fmtPct,
  pctBarWidth,
  type SnapshotRow,
  type ChangeRow,
} from "../lib/demographicChange";

// Per-state + per-CD demographic change over time [E2.4]. Two ACS 5-year endpoints compared
// (Q7.5) when a multi-year bake has landed; until then the change section is honestly empty
// (no placeholder numbers) and we show the latest sourced ACS snapshot. Caveats are required.
const snapshotRelease = stateSnapshotTable.acs_release;
const national = nationalTotals();

// --- Snapshot tables ---
const stateCols: Column[] = [
  { key: "area", label: "State" },
  { key: "pop", label: "Population", align: "right" },
  { key: "inc", label: "Median income", align: "right" },
];
const stateRows = [...stateSnapshotTable.rows]
  .sort((a, b) => (b.population ?? 0) - (a.population ?? 0))
  .map((r) => ({
    area: r.area ?? r.state,
    pop: r.population == null ? "—" : fmtPop(r.population),
    inc: r.median_income == null ? "—" : fmtIncome(r.median_income),
  }));

// Per-CD grain: honest highlights rather than a 435-row wall.
const cds = districtSnapshotTable.rows.filter((r) => r.population != null);
const byPop = [...cds].sort((a, b) => (b.population ?? 0) - (a.population ?? 0));
const withInc = cds.filter((r) => r.median_income != null);
const byInc = [...withInc].sort((a, b) => (b.median_income ?? 0) - (a.median_income ?? 0));
const label = (r?: SnapshotRow) => r?.area ?? r?.geoid ?? "—";

// --- Change (present only after a >=2-endpoint bake) ---
const showChange = hasChangeData();
const meta = changeMetadata();
const stChanges = stateChanges();
const byGrowth = [...stChanges]
  .filter((r) => r.population_pct != null)
  .sort((a, b) => (b.population_pct ?? 0) - (a.population_pct ?? 0));
const topGrowth = byGrowth.slice(0, 6);
const topDecline = byGrowth.slice(-3).reverse();
const cdChanges = [...districtChanges()]
  .filter((r) => r.population_pct != null)
  .sort((a, b) => Math.abs(b.population_pct ?? 0) - Math.abs(a.population_pct ?? 0))
  .slice(0, 8);

const stChangeCols: Column[] = [
  { key: "area", label: "State" },
  { key: "pop", label: `Pop. change ${meta?.state_early_year ?? ""}→${meta?.state_late_year ?? ""}`, align: "right" },
  { key: "popPct", label: "Pop. %", align: "right" },
  { key: "inc", label: "Median income change", align: "right" },
  { key: "incPct", label: "Income %", align: "right" },
];
const stChangeRows = stChanges.map((r: ChangeRow) => ({
  area: r.area ?? r.state,
  pop: fmtDelta(r.population_delta),
  popPct: fmtPct(r.population_pct),
  inc: r.median_income_delta == null ? "—" : `${r.median_income_delta > 0 ? "+" : r.median_income_delta < 0 ? "-" : ""}${fmtIncome(Math.abs(r.median_income_delta))}`,
  incPct: fmtPct(r.median_income_pct),
}));
---

<Layout
  title="Demographic change"
  description="How district and state population and income shift over time, comparing two Census ACS 5-year endpoints — with the caveats that comparison demands."
>
  <h1 class="text-3xl font-bold">Demographic change</h1>
  <p class="mt-2 max-w-prose text-muted">
    How population and median income shift across states and congressional districts over
    time. We compare <strong>two</strong> Census ACS 5-year endpoints rather than reading a
    single snapshot as destiny. Figures are American Community Survey estimates (with margins
    of error) — read them with the <a href="#caveats" class="underline">caveats</a> below.
    Source: <a href="/sources" class="underline">Census ACS</a>.
  </p>

  <section class="mt-8" aria-labelledby="change">
    <SectionHeader title="Change over time" id="change">
      {showChange && meta ? (
        <Fragment slot="source">
          States {meta.acs_release_state_early} → {meta.acs_release_late}; districts{" "}
          {meta.acs_release_cd_early} → {meta.acs_release_late}.
        </Fragment>
      ) : (
        <Fragment slot="source">Awaiting a second sourced ACS endpoint.</Fragment>
      )}
    </SectionHeader>

    {!showChange ? (
      <EmptyState
        class="mt-3"
        title="Change over time needs a second sourced ACS endpoint."
        body="We compare two ACS 5-year releases and don't publish placeholder numbers. The pipeline supports a multi-year bake (acs.run_years); once a second endpoint is baked and exported, per-state and per-district deltas appear here automatically. The current sourced snapshot is below."
      />
    ) : (
      <>
        {meta?.state_crosses_redistricting && (
          <p class="mt-3 max-w-prose text-xs text-muted">
            The state horizon straddles the 2020 redistricting. State totals are boundary-stable
            and safe to compare; district-level change is limited to endpoints on the same
            (118th-Congress) boundaries — see caveats.
          </p>
        )}
        <div class="mt-4 flex flex-wrap gap-x-10 gap-y-4">
          {topGrowth[0] && (
            <StatBlock
              value={fmtPct(topGrowth[0].population_pct)}
              label={`Fastest-growing state (${topGrowth[0].area})`}
              sub={`${fmtDelta(topGrowth[0].population_delta)} people`}
            />
          )}
          {topDecline[0] && (
            <StatBlock
              value={fmtPct(topDecline[0].population_pct)}
              label={`Largest decline (${topDecline[0].area})`}
              sub={`${fmtDelta(topDecline[0].population_delta)} people`}
            />
          )}
        </div>

        {/* PartyBar-style magnitude bars for the biggest movers */}
        <ul class="mt-6 space-y-2" role="list">
          {topGrowth.slice(0, 8).map((r) => (
            <li class="grid grid-cols-[9rem_1fr_4rem] items-center gap-3 text-sm">
              <span class="truncate font-medium">{r.area}</span>
              <span
                class="flex h-4 w-full overflow-hidden rounded-sm bg-surface-2"
                role="img"
                aria-label={`${r.area} population change ${fmtPct(r.population_pct)}`}
              >
                <span
                  class="block h-full bg-[var(--color-accent)]"
                  style={`width:${pctBarWidth(r.population_pct)}%`}></span>
              </span>
              <span class="text-right tabular-nums text-muted">{fmtPct(r.population_pct)}</span>
            </li>
          ))}
        </ul>

        <DataTable
          class="mt-6"
          columns={stChangeCols}
          rows={stChangeRows}
          caption="Population and median-income change by state between two ACS 5-year endpoints"
        />

        {cdChanges.length > 0 && (
          <div class="mt-8">
            <h3 class="font-medium">Biggest district shifts</h3>
            <p class="text-xs text-muted">
              Districts on {meta?.acs_release_cd_early} → {meta?.acs_release_late} (same boundaries).
            </p>
            <ul class="mt-3 space-y-1.5" role="list">
              {cdChanges.map((r) => (
                <li class="flex justify-between text-sm">
                  <span class="font-medium">{r.area}</span>
                  <span class="tabular-nums text-muted">
                    {fmtDelta(r.population_delta)} ({fmtPct(r.population_pct)})
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    )}
  </section>

  <section class="mt-12" aria-labelledby="snapshot">
    <SectionHeader title={`Current snapshot`} id="snapshot" source={`${snapshotRelease}. Population and median household income.`} />
    <div class="mt-3 flex flex-wrap gap-x-10 gap-y-2">
      <StatBlock value={fmtPop(national.population)} label="Total population (states)" size="lg" />
      {national.median_income != null && (
        <StatBlock value={fmtIncome(national.median_income)} label="Pop-weighted median income" size="lg" />
      )}
    </div>

    <div class="mt-6">
      <h3 class="font-medium">By congressional district</h3>
      <div class="mt-3 flex flex-wrap gap-x-10 gap-y-4">
        <StatBlock value={label(byPop[0])} label="Most populous district" sub={byPop[0] && fmtPop(byPop[0].population!)} />
        <StatBlock value={label(byPop.at(-1))} label="Least populous district" sub={byPop.at(-1) && fmtPop(byPop.at(-1)!.population!)} />
        <StatBlock value={label(byInc[0])} label="Highest median income" sub={byInc[0] && fmtIncome(byInc[0].median_income!)} />
        <StatBlock value={label(byInc.at(-1))} label="Lowest median income" sub={byInc.at(-1) && fmtIncome(byInc.at(-1)!.median_income!)} />
      </div>
    </div>

    <DataTable
      class="mt-8"
      columns={stateCols}
      rows={stateRows}
      caption="Population and median household income by state"
    />
  </section>

  <section class="mt-12" aria-labelledby="caveats">
    <SectionHeader title="Caveats" id="caveats" />
    <div class="mt-3 max-w-prose space-y-3 text-sm text-muted">
      <p>
        <strong class="text-fg">Ecological fallacy.</strong> These are area aggregates. A district's
        totals describe the district, not the people in it — you cannot infer any individual's
        income, behavior, or vote from a district-level figure, and a shift in an area's average can
        happen with no one changing (people move in and out). Don't read a demographic trend as a
        statement about how a group votes.
      </p>
      <p>
        <strong class="text-fg">Margins of error.</strong> Every ACS figure is a survey estimate with
        a margin of error, not an exact count. Small differences — especially small
        district-to-district or year-to-year changes — can fall within the margin and not be
        statistically meaningful. Treat small deltas as noise.
      </p>
      <p>
        <strong class="text-fg">Overlapping 5-year windows &amp; boundary changes.</strong> ACS
        5-year releases pool five years of responses, so consecutive releases overlap and change is
        smoothed and lagged. District boundaries also change (2020 redistricting): comparing a code
        like <code>48-07</code> across a redistricting compares two different geographies. We limit
        district comparisons to endpoints on the same boundaries; state totals are boundary-stable.
      </p>
      <p>
        Estimates are American Community Survey 5-year data. Source and freshness:
        <a href="/sources" class="underline">Data sources</a>.
      </p>
    </div>
  </section>
</Layout>
