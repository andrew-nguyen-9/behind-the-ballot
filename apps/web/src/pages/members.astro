---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ListRow from "../components/ListRow.astro";
import EmptyState from "../components/EmptyState.astro";
import FilterBar from "../components/FilterBar.astro";
import { allMembers } from "../lib/members";
import { partyLabel } from "../lib/races";
import { facetOptions, groupBy } from "../lib/directory";

// Member index. Grouped by chamber server-side (0-JS fallback), enhanced by the FilterBar
// island [Q6.7]: re-group by chamber/state/party and filter by state/party/name.
const members = allMembers();

const CHAMBER_LABEL: Record<string, string> = {
  sen: "U.S. Senate",
  rep: "U.S. House",
};

const seat = (m: (typeof members)[number]) =>
  m.chamber === "rep" ? `${m.state}-${String(m.district).padStart(2, "0")}` : m.state;

const groups = groupBy(members, (m) => m.chamber, ["sen", "rep"]);

const partyLabels = Object.fromEntries(
  facetOptions(members, (m) => m.party).map((p) => [p, partyLabel(p)]),
);
const facets = [
  {
    key: "state",
    label: "State",
    options: facetOptions(members, (m) => m.state).map((s) => ({ value: s, label: s })),
  },
  {
    key: "party",
    label: "Party",
    options: facetOptions(members, (m) => m.party).map((p) => ({ value: p, label: partyLabel(p) })),
  },
];
const groupDims = [
  { key: "chamber", label: "Chamber", labels: CHAMBER_LABEL },
  { key: "state", label: "State" },
  { key: "party", label: "Party", labels: partyLabels },
];
---

<Layout title="Members" description="Profiles for members of Congress.">
  <h1 class="text-3xl font-bold">Members</h1>
  <p class="mt-2 text-muted">{members.length} member{members.length === 1 ? "" : "s"} tracked.</p>

  <div data-directory>
    <FilterBar facets={facets} groups={groupDims} noun="member" />

    <div data-groups>
      {groups.map(({ key, items }) => (
        <section class="mt-8" data-group={key} aria-labelledby={key}>
          <SectionHeader title={CHAMBER_LABEL[key] ?? key} id={key} />
          <ul class="mt-3 divide-y divide-[var(--color-border)]" role="list">
            {items.map((m) => (
              <ListRow
                href={`/members/${m.bioguide_id}`}
                party={m.party}
                title={m.name}
                meta={`${partyLabel(m.party)} · ${seat(m)}`}
                data={{
                  "data-row": "",
                  "data-chamber": m.chamber,
                  "data-state": m.state,
                  "data-party": m.party,
                  "data-search": m.name.toLowerCase(),
                }}
              />
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div data-empty hidden class="mt-6">
      <EmptyState title="No members match your filters" body="Try clearing the search or a filter." />
    </div>
  </div>
</Layout>
