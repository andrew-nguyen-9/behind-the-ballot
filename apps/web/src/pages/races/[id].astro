---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PartyBar from "../../components/PartyBar.astro";
import StatBlock from "../../components/StatBlock.astro";
import ListRow from "../../components/ListRow.astro";
import PartySwatch from "../../components/PartySwatch.astro";
import Chip from "../../components/Chip.astro";
import EmptyState from "../../components/EmptyState.astro";
import { allRaces, partyLabel } from "../../lib/races";
import { membersForRace } from "../../lib/members";
import {
  certificationLabel,
  fmtAsOf,
  fmtVotes,
  reportingLabel,
  resultsForRace,
} from "../../lib/results";
import { financeForRace, fmtPct, fmtUSD } from "../../lib/finance";
import { pollingForRace } from "../../lib/polling";
import { forecastForRace, marginLabel } from "../../lib/forecast";
import { demographicsForRace, fmtIncome, fmtPop } from "../../lib/demographics";
import { districtShape, ringToSvg } from "../../lib/geo";
import { socialForEntity, isLinkable } from "../../lib/social";
import ForecastTrend from "../../components/dashboard/ForecastTrend.astro";
import SocialBlock from "../../components/SocialBlock.astro";
import type { TrendPoint } from "../../components/dashboard/forecastTrend";
import type { RaceConfig } from "../../config/schema";

// Baked forecast-run history for the win-probability trend [E-5]. The cron writer bakes the
// forecast_snapshots (Neon) rows for each unit to src/data/forecast-history/<raceId>.json; the
// dir is absent until that lands → empty glob → honest-empty trend (never a fabricated point).
const forecastHistoryMods = import.meta.glob("../../data/forecast-history/*.json", { eager: true });

// One SSG page per race config [F4c]. Real finance/polling/forecast figures attach in
// v1.3.4 / v1.4.4 / v1.8.6 (consuming baked gold artifacts) — this is the core shell.
export function getStaticPaths() {
  return allRaces().map((race) => ({ params: { id: race.id }, props: { race } }));
}

const { race } = Astro.props as { race: RaceConfig };
const officeLabel = { senate: "U.S. Senate", house: "U.S. House", governor: "Governor" }[
  race.office
];
const seat =
  race.office === "house" ? `${race.state}-${String(race.district).padStart(2, "0")}` : race.state;

// Election results [E3.2] — live SoS vote totals, provisional until MEDSL certification.
// Baked per race by export_results ONLY once a real feed reports; until then this is null
// and the section shows an honest empty state (no fabricated numbers, repo rule). The
// "called" flag is borrowed from Wikipedia (CC BY-SA) — SoS feeds carry no projection.
const results = resultsForRace(race.id);
const resultsCandidates = results?.candidates ?? [];
const resultsCalledName = results?.is_called ? results.called_by : null;

// Finance figures [G13a] — join candidates by FEC id; bars scale to the max receipts.
// ponytail: accessible CSS bars (0 JS) over a chart island for a 2-way money compare.
const finance = financeForRace(race.id);
const financeByFec = new Map((finance ?? []).map((f) => [f.candidate_id, f]));
const maxReceipts = Math.max(1, ...(finance ?? []).map((f) => f.receipts));
const coverage = finance?.[0]?.coverage_end_date ?? null;

// Polling average [H1a] — per-party weighted average; 0-JS bars on a 0–100 scale.
// ponytail: headline average now; a trend sparkline (needs snapshot history) is a later
// island. partyColorClass reused for the bar fill.
const polling = pollingForRace(race.id);

// Forecast [N4a] — heuristic+MC win prob + predicted margin + 80% range. Derived figure:
// methodology + provenance linked, not a raw source row [R14a].
const forecast = forecastForRace(race.id);
const demPct = forecast ? Math.round(forecast.win_prob * 100) : 0;
const fhMod = forecastHistoryMods[`../../data/forecast-history/${race.id}.json`] as
  | { default: TrendPoint[] }
  | undefined;
const forecastHistory: TrendPoint[] = fhMod?.default ?? [];

// Official social profiles per candidate [E-6]. Curated official handles only; honest-empty
// until a verified handle is linked (never fabricated). Keyed by FEC candidate id (the id the
// social source will carry); a candidate with no verified handle contributes nothing.
const candidateSocial = race.candidates.map((c) => ({
  candidate: c,
  profiles: c.fecCandidateId ? socialForEntity(c.fecCandidateId) : [],
}));
const anyCandidateSocial = candidateSocial.some((cs) => cs.profiles.some(isLinkable));

// Demographics [I7a] — ACS, keyed to a geometry version [L547].
const demo = demographicsForRace(race.id);

// District shape (house races) — inline SVG now; MapLibre+PMTiles when R2 lands [P8a].
const shape = districtShape(race.id);
const shapeSvg = shape ? ringToSvg(shape.ring) : null;

// Geographic crosslink [M8a]: sitting members for this seat (state/district join).
const seatMembers = membersForRace(race.state, race.office, race.office === "house" ? race.district : null);
---

<Layout title={race.title} description={`${officeLabel} race — ${race.title}.`}>
  <nav class="text-sm text-muted"><a href="/races" class="hover:underline">Races</a> / {seat}</nav>
  <h1 class="mt-2 text-3xl font-bold">{race.title}</h1>
  <p class="mt-1 text-muted">
    {officeLabel} · {seat} · <span class="capitalize">{race.status}</span> · {race.cycle}
  </p>

  <section class="mt-8" aria-labelledby="cands">
    <SectionHeader title="Candidates" id="cands" />
    {race.candidates.length === 0 ? (
      <p class="mt-3 text-muted">Candidates to be confirmed.</p>
    ) : (
      <ul class="mt-4 space-y-3" role="list">
        {race.candidates.map((c) => (
          <li class="flex items-center gap-3">
            <PartySwatch party={c.party} size="md" />
            <span class="font-medium">{c.name}</span>
            <span class="text-sm text-muted">{partyLabel(c.party)}</span>
            {c.incumbent && <Chip label="Incumbent" variant="muted" class="py-0.5 text-xs" />}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-10" aria-labelledby="results">
    <SectionHeader title="Results" id="results">
      <Fragment slot="source">
        {results ? (
          <>
            {certificationLabel(results)} · {reportingLabel(results)} · as of {fmtAsOf(results.as_of)}.
            Source: <a href="/sources" class="underline">state election officials</a>
            {results.is_called && results.call_source ? (
              <> · race call via {results.call_source} (CC BY-SA)</>
            ) : null}.
          </>
        ) : (
          <>Live vote totals from state election officials. Source: <a href="/sources" class="underline">state SoS feeds</a>.</>
        )}
      </Fragment>
    </SectionHeader>

    {!results || resultsCandidates.length === 0 ? (
      <EmptyState
        class="mt-4"
        title="No results yet"
        body="Vote totals will appear here once this race is held and state election officials begin reporting. Numbers are never estimated."
      />
    ) : (
      <>
        {!results.is_certified && (
          <p class="mt-4 rounded-lg border border-[var(--color-border)] bg-surface px-3 py-2 text-sm text-muted">
            <strong class="text-[var(--color-text)]">Unofficial results.</strong> Provisional
            counts from state officials, still moving as ballots are counted. Superseded by
            certified totals later.
          </p>
        )}
        {resultsCalledName && (
          <p class="mt-3 text-sm">
            <Chip label={`Called: ${resultsCalledName}`} variant="solid" class="py-0.5 text-xs" />
          </p>
        )}
        <ul class="mt-4 space-y-3" role="list">
          {resultsCandidates.map((c) => (
            <li>
              <div class="flex items-center justify-between gap-3 text-sm">
                <span class="flex items-center gap-2 font-medium">
                  <PartySwatch party={c.party ?? "?"} size="sm" />
                  {c.candidate}
                  {resultsCalledName === c.candidate && (
                    <span class="text-muted">· winner</span>
                  )}
                </span>
                <span class="tabular-nums text-muted">
                  {fmtVotes(c.votes)} {c.pct !== null ? `· ${c.pct.toFixed(1)}%` : ""}
                </span>
              </div>
              <PartyBar
                class="mt-1 h-2"
                max={100}
                segments={[{
                  party: c.party ?? "?",
                  value: c.pct ?? 0,
                  label: `${c.candidate}: ${c.pct !== null ? `${c.pct.toFixed(1)} percent` : `${fmtVotes(c.votes)} votes`}`,
                }]}
              />
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <section class="mt-10" aria-labelledby="finance">
    <SectionHeader title="Campaign finance" id="finance">
      <Fragment slot="source">
        Figures as reported to the FEC{coverage ? ` through ${coverage}` : ""}; shown blank where a
        committee has not disclosed them. Source: <a href="/sources" class="underline">FEC</a> (public domain).
      </Fragment>
    </SectionHeader>

    {!finance || finance.length === 0 ? (
      <EmptyState
        class="mt-4"
        title="No campaign finance reported yet"
        body="No FEC committee filings are linked to this race's candidates yet."
      />
    ) : (
      <ul class="mt-4 space-y-3" role="list">
        {race.candidates.map((c) => {
          const f = c.fecCandidateId ? financeByFec.get(c.fecCandidateId) : undefined;
          if (!f) {
            return (
              <li class="rounded-lg border border-[var(--color-border)] p-4">
                <div class="flex items-center gap-2">
                  <PartySwatch party={c.party} size="sm" />
                  <span class="font-medium">{c.name}</span>
                </div>
                <p class="mt-1 text-sm text-muted">No FEC committee linked — finance not reported.</p>
              </li>
            );
          }
          return (
            <li class="rounded-lg border border-[var(--color-border)]">
              <details>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4">
                  <span class="flex items-center gap-2 font-medium">
                    <PartySwatch party={c.party} size="sm" />
                    {c.name}
                  </span>
                  <span class="text-sm tabular-nums text-muted">
                    {fmtUSD(f.receipts)} raised · {fmtUSD(f.cash_on_hand)} cash
                  </span>
                </summary>
                <div class="border-t border-[var(--color-border)] p-4">
                  <PartyBar
                    class="h-2"
                    max={maxReceipts}
                    segments={[{ party: c.party, value: f.receipts, label: `${c.name}: ${fmtUSD(f.receipts)} raised` }]}
                  />
                  <dl class="mt-4 grid grid-cols-2 gap-x-8 gap-y-3 sm:grid-cols-3">
                    <div>
                      <dt class="text-sm text-muted">Total receipts</dt>
                      <dd class="text-lg font-bold tabular-nums">{fmtUSD(f.receipts)}</dd>
                    </div>
                    <div>
                      <dt class="text-sm text-muted">Total disbursements</dt>
                      <dd class="text-lg font-bold tabular-nums">{fmtUSD(f.disbursements)}</dd>
                    </div>
                    <div>
                      <dt class="text-sm text-muted">Cash on hand</dt>
                      <dd class="text-lg font-bold tabular-nums">{fmtUSD(f.cash_on_hand)}</dd>
                    </div>
                    <div>
                      <dt class="text-sm text-muted">Burn rate</dt>
                      <dd class="text-lg font-bold tabular-nums">
                        {f.burn_rate === null ? (
                          <span class="font-normal text-muted">Not reported</span>
                        ) : (
                          fmtPct(f.burn_rate)
                        )}
                      </dd>
                      {f.burn_rate !== null && <p class="text-xs text-muted">spending ÷ raising</p>}
                    </div>
                    <div>
                      <dt class="text-sm text-muted">Coverage through</dt>
                      <dd class="text-lg font-bold tabular-nums">
                        {f.coverage_end_date ?? <span class="font-normal text-muted">Not reported</span>}
                      </dd>
                    </div>
                  </dl>
                </div>
              </details>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  {polling && polling.averages.length > 0 && (
    <section class="mt-10" aria-labelledby="polling">
      <SectionHeader title="Polling average" id="polling">
        <Fragment slot="source">
          Weighted average as of {polling.as_of} ({polling.averages[0].n_polls} polls). Source:
          <a href="/sources" class="underline">538</a>.
        </Fragment>
      </SectionHeader>
      <ul class="mt-4 space-y-3" role="list">
        {polling.averages.map((a) => (
          <li>
            <div class="flex justify-between text-sm">
              <span class="font-medium">{partyLabel(a.party)}</span>
              <span class="tabular-nums text-muted">{a.avg_pct.toFixed(1)}%</span>
            </div>
            <PartyBar
              class="mt-1 h-2"
              max={100}
              segments={[{ party: a.party, value: a.avg_pct, label: `${partyLabel(a.party)}: ${a.avg_pct.toFixed(1)} percent` }]}
            />
          </li>
        ))}
      </ul>
    </section>
  )}

  {shapeSvg && (
    <section class="mt-10" aria-labelledby="district">
      <SectionHeader title="District" id="district">
        <Fragment slot="source">
          {seat} boundary (as of {shape!.as_of}). Source:
          <a href="/sources" class="underline">Census TIGER/Line</a>.
        </Fragment>
      </SectionHeader>
      <svg
        viewBox={shapeSvg.viewBox}
        class="mt-3 h-48 w-48"
        role="img"
        aria-label={`Outline of district ${seat}`}
      >
        <path d={shapeSvg.d} class="fill-surface stroke-[var(--color-accent)]" stroke-width="2" />
      </svg>
    </section>
  )}

  {demo && (
    <section class="mt-10" aria-labelledby="demographics">
      <SectionHeader title="Demographics" id="demographics">
        <Fragment slot="source">
          {demo.area} · {demo.acs_release}. Source: <a href="/sources" class="underline">Census ACS</a>.
        </Fragment>
      </SectionHeader>
      <div class="mt-3 flex flex-wrap gap-x-10 gap-y-2">
        <StatBlock value={fmtPop(demo.population)} label="Population" />
        <StatBlock value={fmtIncome(demo.median_income)} label="Median income" />
        {demo.urbanization && (
          <StatBlock value={demo.urbanization} label="Urbanization" class="capitalize" />
        )}
      </div>
    </section>
  )}

  {forecast && (
    <section class="mt-10" aria-labelledby="forecast">
      <SectionHeader title="Forecast" id="forecast">
        <Fragment slot="source">
          As of {forecast.as_of}. Heuristic + Monte Carlo —
          <a href="/forecast" class="underline">methodology</a>.
        </Fragment>
      </SectionHeader>
      <div class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
        <StatBlock value={`${demPct}%`} label="Democratic win probability" />
        <StatBlock
          value={marginLabel(forecast.margin)}
          label={`predicted margin (range ${marginLabel(forecast.margin_lo)} to ${marginLabel(forecast.margin_hi)})`}
        />
      </div>
      <ForecastTrend current={forecast} history={forecastHistory} />
    </section>
  )}

  <section class="mt-10" aria-labelledby="social">
    <SectionHeader title="Official social" id="social">
      <Fragment slot="source">
        Manually verified links to candidates' official public accounts; shown only where a handle
        is verified, never fabricated. Source: <a href="/sources" class="underline">curated official-handle list</a>.
      </Fragment>
    </SectionHeader>
    {!anyCandidateSocial ? (
      <EmptyState
        class="mt-4"
        title="No official social links published"
        body="Verified official-account links appear here as they are curated for this race's candidates. Handles are never guessed."
      />
    ) : (
      <div class="mt-4 grid gap-6 sm:grid-cols-2">
        {candidateSocial
          .filter((cs) => cs.profiles.some(isLinkable))
          .map((cs) => (
            <SocialBlock profiles={cs.profiles} heading={cs.candidate.name} />
          ))}
      </div>
    )}
  </section>

  {seatMembers.length > 0 && (
    <section class="mt-10" aria-labelledby="members">
      <SectionHeader
        title={`Current officeholder${seatMembers.length === 1 ? "" : "s"}`}
        id="members"
        source={`Sitting member${seatMembers.length === 1 ? "" : "s"} for this seat.`}
      />
      <ul class="mt-3 divide-y divide-[var(--color-border)]" role="list">
        {seatMembers.map((m) => (
          <ListRow
            href={`/members/${m.bioguide_id}`}
            party={m.party}
            title={m.name}
            meta={partyLabel(m.party)}
          />
        ))}
      </ul>
    </section>
  )}
</Layout>
