---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PartyBar from "../components/PartyBar.astro";
import PartyLegend from "../components/PartyLegend.astro";
import Chip from "../components/Chip.astro";
import { chamberComposition, CLASS_II_2026_STATES } from "../lib/members";
import { partyLabel } from "../lib/races";

const composition = chamberComposition();
const class2 = [...CLASS_II_2026_STATES].sort();
---

<Layout
  title="Chamber composition"
  description="Party breakdown of the U.S. House and Senate, plus the Senate seats up for election in 2026."
>
  <h1 class="text-3xl font-bold">Chamber composition</h1>
  <p class="mt-2 text-muted">
    Party breakdown per chamber, computed from the tracked member roster. Counts grow as live
    data lands; figures here reflect the current roster.
  </p>

  {composition.map((c) => (
    <section class="mt-8" aria-labelledby={c.chamber}>
      <SectionHeader title={c.label} id={c.chamber} source={`${c.total} seat${c.total === 1 ? "" : "s"} tracked`} />
      {c.total > 0 && (
        <>
          <PartyBar
            class="mt-3"
            max={c.total}
            segments={c.byParty.map((p) => ({
              party: p.party,
              value: p.count,
              label: `${p.count} ${partyLabel(p.party)}`,
            }))}
          />
          <PartyLegend
            class="mt-3"
            items={c.byParty.map((p) => ({ party: p.party, label: partyLabel(p.party), count: p.count }))}
          />
        </>
      )}
    </section>
  ))}

  <section class="mt-10" aria-labelledby="class2">
    <SectionHeader
      title="Senate seats up in 2026 (Class II)"
      id="class2"
      source="Senate seats are elected for six-year terms staggered into three classes. The 33 Class II seats below are on the ballot in 2026."
    />
    <ul class="mt-3 flex flex-wrap gap-2" role="list">
      {class2.map((st) => (
        <li><Chip label={st} /></li>
      ))}
    </ul>
  </section>
</Layout>
