---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import SearchDialog from "../components/SearchDialog.tsx";
import TextSizeControl from "../components/TextSizeControl.astro";
import {
  AN9_LABEL,
  AN9_URL,
  footerColumns,
  primaryNav,
} from "../config/nav";

// Base shell: meta + OG + JSON-LD + header (desktop nav + 0-JS mobile disclosure) +
// footer [U3a,U5a,E0.5]. Every page renders through this. ponytail: static default OG
// now; per-page generated OG cards [C14a] land in a later SEO unit (v1.9.2).
interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown>; // optional per-type JSON-LD (Person, etc.) [U3a]
}

const {
  title = "Behind the Ballot",
  description = "Non-partisan 2026 midterm tracking & analytics.",
  schema,
} = Astro.props;

const fullTitle = title === "Behind the Ballot" ? title : `${title} · Behind the Ballot`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Static OG/social mark [E-D1] — the shipped E-F1 Civic Lattice card (1200×630). One
// default image site-wide; per-page generated OG cards [C14a] remain a later SEO unit.
const ogImage = new URL("/og.png", Astro.site).href;

// JSON-LD WebSite [U3a]. Per-type schema (Person/Place/etc.) added per module.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Behind the Ballot",
  url: Astro.site?.toString(),
  description,
};

const year = new Date().getFullYear();
// Shared shell container: capped + centered, fluid gutters that grow toward 2560px.
// Header / main / footer all use this so vertical edges line up 320–2560px [E0.5].
// primaryNav (from config/nav) drives both the desktop nav and the mobile disclosure.
const shell = "mx-auto w-full max-w-4xl px-4 sm:px-6";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* No-FOUC theme boot [E0.2]: must run before first paint, so it's inlined (not a
        bundled/deferred module) and self-contained. Mirrors resolveInitialTheme() in
        lib/theme.ts. Sets html[data-theme] from a stored pref, else the OS setting. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>

    <!-- No-FOUC text-size [Q4.3]: apply the saved rem-scale step before first paint. Mirror
         of the theme no-FOUC pattern (E0.2). Guarded for storage-blocked contexts. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("btb-text-size");
          if (s === "m" || s === "l") document.documentElement.setAttribute("data-text-size", s);
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Single JS-managed theme-color [E0.2] — follows the active (possibly toggled) theme,
        which media-scoped metas can't. Boot value tracks the default light palette; the
        toggle island updates it on load + on switch. */}
    <meta name="theme-color" content="#0b6e4f" />
    <script is:inline>
      (function () {
        try {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta && document.documentElement.dataset.theme === "dark") {
            meta.setAttribute("content", "#0a0f14");
          }
        } catch (e) {}
      })();
    </script>

    <!-- Brand type: Fraunces (display), Chivo (UI/body), Recursive (mono labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Chivo:wght@300;400;500;600;700&family=Recursive:MONO,wght@1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Behind the Ballot — the data beneath democracy" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:p-2">Skip to content</a>
    <header
      class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-surface-glass)] backdrop-blur-md"
    >
      <nav
        class={`relative flex items-center gap-x-1 py-3 sm:gap-x-6 ${shell}`}
        aria-label="Primary"
      >
        <a href="/" class="flex items-center gap-2.5" aria-label="Behind the Ballot — home">
          <span class="flex text-[var(--color-brand)]">
            {/* Civic Lattice identity mark [E-D1 rollout of E-F1] — replaces the legacy
                inline ballot-box glyph; decorative since the wordmark carries the name. */}
            <Logo size={26} decorative />
          </span>
          <span class="font-serif text-lg leading-none tracking-tight">
            <span class="font-normal">Behind the</span> <span class="font-semibold">Ballot</span>
          </span>
        </a>

        {/* Desktop nav — inline links from sm up. */}
        <ul class="eyebrow ml-auto hidden flex-wrap items-center gap-1 sm:flex" role="list">
          {primaryNav.map((l) => (
            <li>
              <a
                href={l.href}
                class="rounded px-2.5 py-1.5 text-[var(--color-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-brand)]"
              >{l.label}</a>
            </li>
          ))}
        </ul>
        {/* Search + a11y controls — compact, shown at all widths; sit right of the desktop
            nav (ml-auto on the ul) and left of the mobile disclosure. */}
        <SearchDialog client:idle />
        <!-- A11y cluster [Q4.4]: text-size control + theme toggle (E0.2). -->
        <div class="flex items-center" aria-label="Accessibility options">
          <TextSizeControl />
          <button
            id="theme-toggle"
            type="button"
            class="rounded p-1.5 text-[var(--color-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-brand)]"
            aria-label="Toggle dark mode"
          >
            {/* Moon (shown in light) / sun (shown in dark) — visibility swapped via CSS on
                html[data-theme]. Renders correctly with JS off (moon = default). */}
            <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </div>

        {/* Mobile nav — 0-JS hamburger disclosure (<details>). Usable at 320px. */}
        <details
          class="sm:hidden [&[open]_.i-close]:block [&[open]_.i-menu]:hidden"
        >
          <summary
            class="flex cursor-pointer list-none items-center rounded p-1.5 text-[var(--color-muted)] hover:text-[var(--color-brand)] [&::-webkit-details-marker]:hidden"
            aria-label="Toggle navigation menu"
          >
            <svg class="i-menu" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg class="i-close hidden" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </summary>
          <ul
            class="absolute inset-x-0 top-full flex flex-col border-b border-[var(--color-border)] bg-[var(--color-surface-glass)] px-4 py-2 backdrop-blur-md"
            role="list"
          >
            {primaryNav.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="block rounded px-2 py-2.5 text-[var(--color-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-brand)]"
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    </header>

    <script>
      import { nextTheme, THEME_COLOR, type Theme } from "../lib/theme";

      const btn = document.getElementById("theme-toggle");
      if (btn) {
        const current = (): Theme =>
          document.documentElement.dataset.theme === "dark" ? "dark" : "light";
        const apply = (theme: Theme) => {
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem("theme", theme);
          } catch (e) {}
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", THEME_COLOR[theme]);
          btn.setAttribute("aria-pressed", String(theme === "dark"));
        };
        btn.setAttribute("aria-pressed", String(current() === "dark"));
        btn.addEventListener("click", () => apply(nextTheme(current())));
      }
    </script>

    <main id="main" data-pagefind-body class={`py-12 ${shell}`}>
      <slot />
    </main>

    <footer class="mt-16 border-t border-[var(--color-border)]">
      <div class={`py-12 ${shell}`}>
        <div class="flex flex-col gap-10 md:flex-row md:justify-between">
          <div class="max-w-xs">
            <p class="eyebrow mb-2 text-[var(--color-subtle)]">See past the vote</p>
            <p class="text-sm text-[var(--color-muted)]">
              Non-partisan. Every figure traces to a source — see <a
                class="font-medium text-[var(--color-brand)] underline underline-offset-2"
                href="/sources">sources</a>.
            </p>
            <a
              href={AN9_URL}
              class="mt-5 inline-flex items-center gap-1.5 rounded-md bg-[var(--color-brand)] px-3.5 py-2 text-sm font-medium text-[color:var(--color-on-brand)] transition-colors hover:opacity-90"
            >
              {AN9_LABEL}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M9 7h8v8"></path>
              </svg>
            </a>
          </div>

          <nav
            class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3"
            aria-label="Footer"
          >
            {footerColumns.map((col) => (
              <div>
                <p class="eyebrow mb-3 text-[var(--color-subtle)]">{col.title}</p>
                <ul class="space-y-2" role="list">
                  {col.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        class="inline-flex items-center gap-1 text-[var(--color-muted)] hover:text-[var(--color-brand)]"
                        {...(l.external
                          ? { target: "_blank", rel: "noopener noreferrer" }
                          : {})}
                      >
                        {l.label}
                        {l.external && (
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 17L17 7M9 7h8v8"></path>
                          </svg>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </div>

        <p class="mt-10 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-muted)]">
          © {year} Behind the Ballot · Non-partisan 2026 midterm tracking.
        </p>
      </div>
    </footer>
  </body>
</html>
